# Copy this file to .env and adjust values for your machine.
# .env is git-ignored. Never commit real credentials.

# --- MySQL container (docker-compose.yml) ---
# Host port the MySQL container is published on. Change it if 3307 is taken.
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=library_db
MYSQL_USER=library
MYSQL_PASSWORD=library

# --- Backend datasource (backend reads this file via spring.config.import) ---
DB_USERNAME=library
DB_PASSWORD=library
# Only needed when using a native MySQL install instead of Docker:
# DB_URL=jdbc:mysql://localhost:3306/library_db
